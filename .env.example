# Copy to .env (git-ignored). Never commit real values.
# `python scripts/deploy.py init-env` fills the OVH_* names and TS_AUTHKEY from project 055's .env
# (only those keys) and, after the first stage, N8N_ENCRYPTION_KEY read back from the VPS.
OVH_VPS_IP=<VPS_IP>
OVH_VPS_USER=ubuntu
OVH_VPS_SSH_PORT=22
OVH_SSH_KEY_PATH=C:\Users\<you>\.ssh\<key>
# Tailscale auth key (tskey-auth-...). Needed only for the first login.
# `deploy.py drop-key` removes it from the VPS .env afterwards.
TS_AUTHKEY=
TS_HOSTNAME=n8n
# Generated on the VPS (openssl rand) straight into /opt/n8n/.env. The PC copy is only a convenience.
# The real backup is the owner's password manager.
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# File nodes may only use /home/node/.n8n-files (host: /opt/n8n/files). It is fixed in docker/compose.yaml, no variable here.
# Owner steps, after the n8n owner account exists (see README). Used only by tier 4 and 5 token tests.
N8N_URL=https://n8n.<tailnet>.ts.net
N8N_API_KEY=
N8N_MCP_TOKEN=